APP_NAME=recording-service
APP_HOST=0.0.0.0
APP_PORT=8000
FFMPEG_PATH=ffmpeg
DATA_DIR=/data/recordings
SEGMENT_TIME_SECONDS=3600
MONITOR_INTERVAL_SECONDS=8
INDEX_INTERVAL_SECONDS=15
NO_OUTPUT_TIMEOUT_SECONDS=30
MAX_STREAMS_PER_NODE=64
RESTART_MAX_ATTEMPTS=6
RESTART_BACKOFF_BASE_SECONDS=2
RESTART_BACKOFF_MAX_SECONDS=60
CIRCUIT_BREAKER_COOLDOWN_SECONDS=120
FFMPEG_STARTUP_PROBE_SECONDS=2
CAMERA_INDEX_API_URL=http://eom.chnenergy.com.cn/wfjt/video/getIndexCode
CAMERA_INDEX_API_PROTOCOL=rtmp
CAMERA_INDEX_API_TIMEOUT_SECONDS=6
DB_URL=postgresql+psycopg2://recording:recording@localhost:5432/recording
REDIS_URL=redis://localhost:6379/0
REDIS_LOCK_TTL_SECONDS=120
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPIC=recording.commands
KAFKA_GROUP_ID=recording-service
NODE_ID=local-node
LOG_LEVEL=INFO
LOG_JSON=true
TZ=Asia/Shanghai
